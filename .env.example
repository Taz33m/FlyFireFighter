# The app runs without environment variables or API keys.
# Keep real credentials in the ignored .env.local file; never commit them.

# Optional: OpenAI Decisions for bounded mission choices. Read only on the server by /api/decisions and
# never sent to the browser. Without it, missions use the local deterministic planner and command shows
# "Local planner"; authority and harness checks are identical either way.
OPENAI_API_KEY=

# Optional: Gemini as a second decider (Mission planner "Gemini" or "Consensus"; see docs/llm-deciders.md).
# Read only on the server by /api/decisions?provider=gemini|consensus, sent only in the x-goog-api-key
# header to generativelanguage.googleapis.com, never logged and never sent to the browser. Without it,
# Gemini runs use the local planner, and consensus runs fall back to the local planner because agreement
# needs both OPENAI_API_KEY and GEMINI_API_KEY. Create a key in Google AI Studio.
GEMINI_API_KEY=

# Optional: MongoDB Atlas persistence of simulation runs (auto-save of finished runs, the Atlas section of
# /results, /replay?atlas=<runId>, mission-log search; see docs/persistence.md). Read only on the server by
# the /api/runs route handlers and the scripts; never sent to the browser, returned or logged. Without
# MONGODB_URI nothing is saved and the app says "not configured". Use the connection string from Atlas →
# Connect → Drivers with your database user's password filled in, e.g.
# mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/?retryWrites=true&w=majority&appName=flyfirefighter
MONGODB_URI=
# Database name; empty means "flyfirefighter".
MONGODB_DB=
# Optional: extra hosts allowed to call /api/runs besides 127.0.0.1:3200 and localhost:3200, comma-separated
# host:port entries (e.g. 192.168.1.20:3200). Malformed entries are ignored.
PERSISTENCE_ALLOWED_HOSTS=
