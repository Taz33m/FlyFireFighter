{
  "name": "flyfirefighter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A rescue drone with a fly's reflexes and a firefighter in command.",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:e2e": "FLYFIREFIGHTER_E2E=1 node --test --test-reporter=spec src/lib/mission/mission.e2e.test.ts"
  },
  "dependencies": {
    "mongodb": "7.8.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  }
}
